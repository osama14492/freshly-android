{
  "rules": {
    ".read": false,
    ".write": false,
    "userRoles": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.uid == 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1')",
        ".write": "auth != null && auth.uid == 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1'"
      },
      ".read": "auth != null && auth.uid == 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1'"
    },
    "pendingOrders": {
      ".read": "auth != null && (auth.uid == 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1' || (root.child('userRoles').child(auth.uid).child('active').val() == true && root.child('userRoles').child(auth.uid).child('permissions').child('orders').val() == true))",
      "$orderId": {
        ".write": "(auth != null && (auth.uid == 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1' || (root.child('userRoles').child(auth.uid).child('active').val() == true && root.child('userRoles').child(auth.uid).child('permissions').child('orders').val() == true))) || (auth == null && !data.exists() && newData.child('id').val() == $orderId && newData.child('status').val() == 'pending' && newData.hasChildren(['id','customer','cart','total','date','time']))"
      }
    },
    "orderTracking": {
      ".read": "auth != null && (auth.uid == 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1' || (root.child('userRoles').child(auth.uid).child('active').val() == true && root.child('userRoles').child(auth.uid).child('permissions').child('orders').val() == true))",
      ".write": "auth != null && (auth.uid == 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1' || (root.child('userRoles').child(auth.uid).child('active').val() == true && root.child('userRoles').child(auth.uid).child('permissions').child('orders').val() == true))"
    }
  }
}
