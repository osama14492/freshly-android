{
  "rules": {
    ".read": false,
    ".write": false,
    "userRoles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1')",
        ".write": "auth != null && auth.uid === 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1'"
      }
    },
    "pendingOrders": {
      ".read": "auth != null && (auth.uid === 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1' || root.child('userRoles').child(auth.uid).child('active').val() === true)",
      "$orderId": {
        ".write": "(auth != null && (auth.uid === 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1' || root.child('userRoles').child(auth.uid).child('active').val() === true)) || (auth == null && !data.exists() && newData.child('status').val() === 'pending' && newData.hasChildren(['id','customer','cart','total','date','time']))"
      }
    },
    "orderTracking": {
      ".read": "auth != null && (auth.uid === 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1' || root.child('userRoles').child(auth.uid).child('active').val() === true)",
      ".write": "auth != null && (auth.uid === 'AiQ3H3qAsRdI4HMvfDfXgQCzplj1' || root.child('userRoles').child(auth.uid).child('active').val() === true)"
    }
  }
}
